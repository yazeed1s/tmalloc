# hits all four coalesce cases on free (cs:app numbering)
# layout after the allocs: [0][1][2][3][4][5][6]
a 0 32
a 1 32
a 2 32
a 3 32
a 4 32
a 5 32
a 6 32
# case 1: prev and next allocated
f 1
# case 3: prev (1) free, next (3) allocated
f 2
# case 1 again, sets up case 2
f 5
# case 2: prev (3) allocated, next (5) free
f 4
# case 4: prev (1+2) free, next (4+5) free
f 3
f 0
f 6
